var 0..1: x1 :: output_var;
var 0..1: x2 :: output_var;
var 0..1: x3 :: output_var;
var 0..1: x4 :: output_var;
var 0..100: profit :: output_var;
constraint int_lin_le([3, 4, 5, 6], [x1, x2, x3, x4], 9);
constraint int_lin_le([2, 2, 3, 5], [x1, x2, x3, x4], 7);
constraint int_lin_eq([10, 9, 8, 12, -1], [x1, x2, x3, x4, profit], 0);
solve maximize profit;
