var 1..4: x0 :: output_var;
var 1..4: x1 :: output_var;
var 1..4: x2 :: output_var;
var 1..4: x3 :: output_var;
var 1..4: x4 :: output_var;
constraint int_ne(x0,x1);
constraint int_ne(x0,x2);
constraint int_ne(x0,x3);
constraint int_ne(x0,x4);
constraint int_ne(x1,x2);
constraint int_ne(x1,x3);
constraint int_ne(x1,x4);
constraint int_ne(x2,x3);
constraint int_ne(x2,x4);
constraint int_ne(x3,x4);
solve satisfy;
