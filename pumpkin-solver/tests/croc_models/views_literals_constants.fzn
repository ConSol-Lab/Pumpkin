var 0..20: x :: output_var;
var 0..9: y :: output_var;
var 0..20: z :: output_var = x;
var bool: b :: output_var;
var 0..1: i :: output_var;
var bool: r1;
var bool: r2;
var 0..10: u :: output_var;
var 0..10: v :: output_var;
var 3..3: k :: output_var;
var 0..9: p :: output_var;
var 0..9: q :: output_var;
var 0..60: obj :: output_var;
constraint int_lin_eq([1,-2],[x,y],1);
constraint bool2int(b,i);
constraint int_le_reif(y,3,r1);
constraint int_le_reif(6,y,r2);
constraint bool_clause([r1,r2],[b]);
constraint int_lin_eq([2,3],[u,v],12);
constraint int_lin_le([1,-1],[u,k],4);
constraint pumpkin_all_different([y,p,q,v]);
constraint int_lin_le([1,1,1],[p,q,y],12);
constraint int_lin_eq([1,1,1,1,-1],[z,i,u,p,obj],0);
solve maximize obj;
