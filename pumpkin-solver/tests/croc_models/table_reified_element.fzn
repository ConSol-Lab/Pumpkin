array [1..6] of int: t = [1,2,2,3,3,1];
array [1..4] of int: costs = [4,1,3,2];
var 1..3: a :: output_var;
var 1..3: b :: output_var;
var 0..10: c :: output_var;
var 1..4: i :: output_var;
var bool: r;
constraint pumpkin_table_int([a,b],t);
constraint int_lin_le_reif([1,-1],[a,b],-1,r);
constraint bool_clause([r],[]);
constraint array_int_element(i,costs,c);
constraint int_lin_le([1,-1],[a,i],0);
solve minimize c;
