{
  "name": "Pumpkin",
  "id": "nl.tudelft.algorithmics.pumpkin",
  "version": "0.5.0",
  "executable": "../target/release/pumpkin-solver",
  "mznlib": "./lib",
  "stdFlags": [
    "-t",
    "-r",
    "-a",
    "-v",
    "-s",
    "-f"
  ],
  "extraFlags": [
    [
      "--omit-timestamp",
      "If `--verbose` is enabled then this option removes the timestamp information from the log messages (only applicable for (W)CNF instances).",
      "bool",
      "false"
    ],
    [
      "--omit-call-site",
      "If `--verbose` is enabled then this option removes the call site information from the log messages (only applicable for (W)CNF instances).",
      "bool",
      "false"
    ],
    [
      "--proof-path",
      "The output path for the proof file. [possible values: string]",
      "string",
      ""
    ],
    [
      "--proof-type",
      "What type of proof to log. [default: scaffold] [possible values: scaffold, full]",
      "opt:scaffold:full",
      "scaffold"
    ],
    [
      "--optimisation-strategy",
      "Determine what type of optimisation strategy is used by the solver [default: linear-sat-unsat] [possible values: linear-sat-unsat, linear-unsat-sat]",
      "opt:linear-sat-unsat:linear-unsat-sat",
      "linear-sat-unsat"
    ],
    [
      "--conflict-resolver",
      "Determines the conflict resolver [default: one-uip] [possible values: no-learning, one-uip, all-decision, extended-cpip, bounds-extended-cpip]",
      "opt:no-learning:one-uip:all-decision:extended-cpip:bounds-extended-cpip",
      "one-uip"
    ],
    [
      "--recursive-minimisation",
      "Decides whether learned clauses are minimised as a post-processing step after computing the 1-UIP Minimisation is done; according to the idea proposed in \"Generalized Conflict-Clause Strengthening for Satisfiability Solvers - Allen van Gelder (2011)\".",
      "bool",
      "false"
    ],
    [
      "--no-iterative-minimisation",
      "Decides whether to apply semantic minimisation during conflict analysis; according to the idea proposed in \"Semantic Learning for Lazy Clause Generation - Feydy et al. (2013)\".",
      "bool",
      "false"
    ],
    [
      "--learning-max-num-high-lbd-nogoods",
      "The number of high-lbd learned nogoods that are kept in the database. [default: 20000] [possible values: int]",
      "int:0:18446744073709551615",
      "20000"
    ],
    [
      "--learning-max-num-mid-lbd-nogoods",
      "The number of mid-lbd learned nogoods that are kept in the database. [default: 7000] [possible values: int]",
      "int:0:18446744073709551615",
      "7000"
    ],
    [
      "--learning-max-num-low-lbd-nogoods",
      "The number of low-lbd learned nogoods that are kept in the database. [default: 100000] [possible values: int]",
      "int:0:18446744073709551615",
      "100000"
    ],
    [
      "--learning-low-lbd-threshold",
      "The treshold determining whether a learned nogood is \"low\" LBD. [default: 3] [possible values: int]",
      "int:0:4294967295",
      "3"
    ],
    [
      "--learning-high-lbd-threshold",
      "The treshold determining whether a learned nogood is \"high\" LBD. [default: 7] [possible values: int]",
      "int:0:4294967295",
      "7"
    ],
    [
      "--memory-preallocated",
      "The amount of memory (in MB) that is preallocated for storing nogoods [default: 50] [possible values: int]",
      "int:0:18446744073709551615",
      "50"
    ],
    [
      "--nogood-priority",
      "The priority of the nogood propagator [default: very-low] [possible values: high, medium, low, very-low, ultra-low, lowest]",
      "opt:high:medium:low:very-low:ultra-low:lowest",
      "very-low"
    ],
    [
      "--no-restarts",
      "Determines that no restarts are allowed by the solver.",
      "bool",
      "false"
    ],
    [
      "--restart-sequence-generator-type",
      "Decides the sequence based on which the restarts are performed. [default: constant] [possible values: constant, geometric, luby]",
      "opt:constant:geometric:luby",
      "constant"
    ],
    [
      "--restart-base-interval",
      "The base interval length is used as a multiplier to the restart sequence. [default: 50] [possible values: int]",
      "int:0:18446744073709551615",
      "50"
    ],
    [
      "--restart-geometric-coef",
      "The coefficient in the geometric sequence `x_i = x_{i-1} * \"--restart-geometric-coef\"` where `x_1 = \"--restarts-base-interval\"`. Used only if \"--restarts-sequence-generator\" is assigned to \"geometric\". [possible values: float]",
      "float",
      ""
    ],
    [
      "--restart-min-initial-conflicts",
      "Indicates the minimum number of initial conflicts before the first restart can occur. [default: 10000] [possible values: int]",
      "int:0:18446744073709551615",
      "10000"
    ],
    [
      "--restart-lbd-coef",
      "Used to determine if a restart should be forced (see \"Refining Restarts Strategies for SAT and UNSAT - Audemard and Simon (2012)\"). [default: 1.25] [possible values: float]",
      "float",
      "1.25"
    ],
    [
      "--restart-num-assigned-coef",
      "Used to determine if a restart should be blocked (see \"Refining Restarts Strategies for SAT and UNSAT - Audemard and Simon (2012)\"). [default: 1.4] [possible values: float]",
      "float",
      "1.4"
    ],
    [
      "--restart-num-assigned-window",
      "Used to determine the length of the recent past that should be considered when deciding on blocking restarts (see \"Refining Restarts Strategies for SAT and UNSAT - Audemard and Simon (2012)\"). [default: 5000] [possible values: int]",
      "int:0:18446744073709551615",
      "5000"
    ],
    [
      "--cumulative-propagation-method",
      "Determines the type of propagator which is used by the cumulative propagator(s) to propagate the constraint. [default: time-table-over-interval-incremental] [possible values: time-table-per-point, time-table-per-point-incremental, time-table-per-point-incremental-synchronised, time-table-over-interval, time-table-over-interval-incremental, time-table-over-interval-incremental-synchronised]",
      "opt:time-table-per-point:time-table-per-point-incremental:time-table-per-point-incremental-synchronised:time-table-over-interval:time-table-over-interval-incremental:time-table-over-interval-incremental-synchronised",
      "time-table-over-interval-incremental"
    ],
    [
      "--cumulative-explanation-type",
      "Determines the type of explanation used by the cumulative propagator(s) to explain propagations/conflicts [default: pointwise] [possible values: naive, big-step, pointwise]",
      "opt:naive:big-step:pointwise",
      "pointwise"
    ],
    [
      "--cumulative-allow-holes",
      "Determines that the cumulative propagator(s) are allowed to create holes in the domain.",
      "bool",
      "false"
    ],
    [
      "--cumulative-single-profiles",
      "Determines whether a single profiles are used generated when explaining a propagation for the cumulative constraint",
      "bool",
      "false"
    ],
    [
      "--cumulative-incremental-backtracking",
      "Determines whether incremental backtracking is applied or whether the cumulative propagators compute the time-table from scratch upon backtracking",
      "bool",
      "false"
    ],
    [
      "--upper-bound-encoding",
      "The encoding to use for the upper bound constraint in a MaxSAT optimisation problem. [default: generalized-totalizer] [possible values: generalized-totalizer, cardinality-network]",
      "opt:generalized-totalizer:cardinality-network",
      "generalized-totalizer"
    ]
  ],
  "tags": [
    "cp",
    "lcg",
    "int"
  ]
}
