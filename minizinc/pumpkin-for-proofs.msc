{
  "name": "PumpkinProof",
  "id": "nl.tudelft.algorithmics.pumpkin_proof",
  "version": "0.5.0",
  "executable": "../target/release/pumpkin-solver",
  "mznlib": "./lib-for-proofs/",
  "stdFlags": [
    "-t",
    "-r",
    "-a",
    "-v",
    "-s",
    "-f"
  ],
  "extraFlags": [
    [
      "--proof-path",
      "The output path for the proof file. [possible values: string]",
      "string",
      ""
    ],
    [
      "--proof-type",
      "What type of proof to log. [default: scaffold] [possible values: scaffold, full]",
      "opt:scaffold:full",
      "scaffold"
    ],
    [
      "--optimisation-strategy",
      "Determines what type of optimisation strategy is used by the solver. [default: linear-sat-unsat] [possible values: linear-sat-unsat, linear-unsat-sat]",
      "opt:linear-sat-unsat:linear-unsat-sat",
      "linear-sat-unsat"
    ],
    [
      "--conflict-resolver",
      "Determines the conflict resolver. [default: one-uip] [possible values: no-learning, one-uip, all-decision, extended-cpip, bounds-extended-cpip]",
      "opt:no-learning:one-uip:all-decision:extended-cpip:bounds-extended-cpip",
      "one-uip"
    ],
    [
      "--recursive-minimisation",
      "Enables recursive minimisation of learned nogoods.",
      "bool",
      "false"
    ],
    [
      "--no-iterative-minimisation",
      "Disables semantic minimisation of learned nogoods.",
      "bool",
      "false"
    ],
    [
      "--learning-max-num-high-lbd-nogoods",
      "The number of high-lbd learned nogoods that are kept in the database. [default: 20000] [possible values: int]",
      "int:0:18446744073709551615",
      "20000"
    ],
    [
      "--learning-max-num-mid-lbd-nogoods",
      "The number of mid-lbd learned nogoods that are kept in the database. [default: 7000] [possible values: int]",
      "int:0:18446744073709551615",
      "7000"
    ],
    [
      "--learning-max-num-low-lbd-nogoods",
      "The number of low-lbd learned nogoods that are kept in the database. [default: 100000] [possible values: int]",
      "int:0:18446744073709551615",
      "100000"
    ],
    [
      "--learning-low-lbd-threshold",
      "The threshold determining whether a learned nogood is \"low\" LBD. [default: 3] [possible values: int]",
      "int:0:4294967295",
      "3"
    ],
    [
      "--learning-high-lbd-threshold",
      "The threshold determining whether a learned nogood is \"high\" LBD. [default: 7] [possible values: int]",
      "int:0:4294967295",
      "7"
    ],
    [
      "--memory-preallocated",
      "The amount of memory (in MB) that is preallocated for storing nogoods. [default: 50] [possible values: int]",
      "int:0:18446744073709551615",
      "50"
    ],
    [
      "--nogood-priority",
      "The priority of the nogood propagator. [default: very-low] [possible values: high, medium, low, very-low, ultra-low, lowest]",
      "opt:high:medium:low:very-low:ultra-low:lowest",
      "very-low"
    ],
    [
      "--no-restarts",
      "Determines that no restarts are allowed by the solver.",
      "bool",
      "false"
    ],
    [
      "--restart-sequence-generator-type",
      "Decides the sequence based on which the restarts are performed. [default: constant] [possible values: constant, geometric, luby]",
      "opt:constant:geometric:luby",
      "constant"
    ],
    [
      "--restart-base-interval",
      "The base interval length which is used as a multiplier to the restart sequence. [default: 50] [possible values: int]",
      "int:0:18446744073709551615",
      "50"
    ],
    [
      "--restart-geometric-coef",
      "The coefficient of the geometric restart sequence. [possible values: float]",
      "float",
      ""
    ],
    [
      "--restart-min-initial-conflicts",
      "Indicates the minimum number of initial conflicts before the first restart can occur. [default: 10000] [possible values: int]",
      "int:0:18446744073709551615",
      "10000"
    ],
    [
      "--restart-lbd-coef",
      "The coefficient used to determine whether a restart should be forced. [default: 1.25] [possible values: float]",
      "float",
      "1.25"
    ],
    [
      "--restart-num-assigned-coef",
      "The coefficient used to determine whether a restart should be blocked. [default: 1.4] [possible values: float]",
      "float",
      "1.4"
    ],
    [
      "--restart-num-assigned-window",
      "The length of the recent past that is considered when deciding whether to block a restart. [default: 5000] [possible values: int]",
      "int:0:18446744073709551615",
      "5000"
    ],
    [
      "--cumulative-propagation-method",
      "Determines the type of propagator which is used for the cumulative constraint. [default: time-table-over-interval-incremental] [possible values: time-table-per-point, time-table-per-point-incremental, time-table-per-point-incremental-synchronised, time-table-over-interval, time-table-over-interval-incremental, time-table-over-interval-incremental-synchronised]",
      "opt:time-table-per-point:time-table-per-point-incremental:time-table-per-point-incremental-synchronised:time-table-over-interval:time-table-over-interval-incremental:time-table-over-interval-incremental-synchronised",
      "time-table-over-interval-incremental"
    ],
    [
      "--cumulative-explanation-type",
      "Determines the type of explanation used by the cumulative propagator(s). [default: pointwise] [possible values: naive, big-step, pointwise]",
      "opt:naive:big-step:pointwise",
      "pointwise"
    ],
    [
      "--cumulative-allow-holes",
      "Determines that the cumulative propagator(s) are allowed to create holes in the domain.",
      "bool",
      "false"
    ],
    [
      "--cumulative-single-profiles",
      "Uses single profiles when explaining propagations of the cumulative constraint.",
      "bool",
      "false"
    ],
    [
      "--cumulative-incremental-backtracking",
      "Enables incremental backtracking for the cumulative propagator(s).",
      "bool",
      "false"
    ]
  ],
  "tags": [
    "cp",
    "lcg",
    "int"
  ]
}
